# Application
APP_NAME=AbleToCompete MVP
VERSION=1.0.0
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/abletocompete

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Monitoring
MONITOR_CHECK_INTERVAL=30
ALERT_COOLDOWN=300

# AI Agents
ENABLE_AI_AGENTS=True
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=          # leave blank to use simulated responses

# Alerts
WEBHOOK_URL=                # Slack/Teams/custom webhook URL; leave blank to skip

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
